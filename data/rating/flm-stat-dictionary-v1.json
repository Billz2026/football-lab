    "bigChancesCreated": ["BIG_CHANCES_CREATED"],
    "backwardPasses": ["BACKWARD_PASSES"],
    "longBalls": ["LONG_BALLS"],
    "longBallsWon": ["LONG_BALLS_WON"],
    "possessionLost": ["POSSESSION_LOST"],
    "ballRecoveries": ["BALL_RECOVERY"],
