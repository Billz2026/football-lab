{
  "name": "Football Lab Manager",
  "short_name": "FL Manager",
  "description": "A fast, focused football management simulation built around tactics, recruitment, development and long-term careers.",
  "id": "./index.html",
  "start_url": "./index.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#050504",
  "theme_color": "#080704",
  "categories": ["games", "sports"],
  "lang": "en-GB",
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "handle_links": "preferred",
  "icons": [
    {
      "src": "./icons/football-lab-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/football-lab-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
